# --- Private files of a specific installation (deployment, project data) ---
/private/

# --- Local configuration (NEVER commit – contains DB passwords) ---
/config/config.php

# --- Deployment package (generated by tools/build-deploy.mjs) ---
/deploy/

# --- PHP / tools ---
*.log
/logs/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Dependencies, in case you vendor them locally ---
# (Leaflet/Geoman are loaded from a CDN by default – see DEPLOY.md)

# --- Environment variables / secret keys ---
.env
.env.local
.env.*.local

# --- Uploaded attachments (data, not code) ---
/storage/*
!/storage/.htaccess
